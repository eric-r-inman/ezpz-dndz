# Before adding things like .DS_Store, ignores for your editors, etc, consider
# instead to use a global git ignore. This keeps the ignores here clean, and
# specific to this project - not your text editor, OS, or other tooling.
#
# Attempts to ignore files specific to your configuration will be rejected.
#
# Please justify all ignore entries with comments.

# Ignore cargo generated build artifacts.
target/

# Elm build cache.
frontend/elm-stuff/

# Compiled Elm bundle (generated by elm-make; not checked in).
frontend/public/elm.js

# Dice-roller history persistence file (created at runtime by the server;
# lives in the --data-dir).
dice-history.json

# Live-encounter persistence file (created at runtime by the server;
# lives in the --data-dir).  Anchored to the
# repo root so it doesn't shadow any same-named file inside the tree.
/encounter.json

# Named encounter-saves persistence file (created at runtime by the
# server; lives in the --data-dir).
/encounter-saves.json

# Named compendium-saves persistence file (created at runtime by the
# server; lives in the --data-dir).
/compendium-saves.json

# Per-user compendium-groups persistence file (created at runtime by
# the server; lives in the --data-dir).
/compendium-groups.json

# Per-user lore-groups persistence file (created at runtime by the
# server; lives in the --data-dir).
/lore-groups.json

# Per-user condition-presets persistence file (created at runtime by
# the server; lives in the --data-dir).
/condition-presets.json

# Per-user treasure-table persistence file (created at runtime by the
# server; lives in the --data-dir).
/treasure-table.json

# Per-user treasure-profiles persistence file (created at runtime by
# the server; lives in the --data-dir).
/treasure-profiles.json

# Per-user Save Chain preset persistence file (created at runtime by
# the server; lives in the --data-dir).
/save-chain-presets.json

# User-account database (created at runtime by the server when the
# first registration lands; carries Argon2id password hashes — must
# never end up in git).  Lives in the --data-dir.
/users.json

# The SQLite database — the live store for every runtime table
# (users with their Argon2id password hashes, encounters, the
# compendium, presets, dice history).  Created on first boot in the
# --data-dir; the -wal/-shm siblings appear while it is open.  This
# is the successor to the per-store JSON files ignored above and
# carries the same absolute prohibition: it must never end up in git.
# A Postgres deployment writes none of these.
/ezpz-dndz.db
/ezpz-dndz.db-wal
/ezpz-dndz.db-shm

# Runtime compendium directory (created at runtime by the server when
# bootstrapping; lives in the --data-dir).
# Leading slash anchors the rule to repo root so it doesn't shadow
# the source-side `frontend/src/Compendium/` module directory.
/compendium/

# Per-user Claude Code overrides (the shared .claude/settings.json IS checked in).
.claude/settings.local.json

# Claude Code session memory — must never be committed even if a session
# accidentally writes there instead of ~/.claude/projects/.
.claude/projects/

# Personal scratchpads — design prompts and ad-hoc notes; not part of the project.
docs/PROMPTS.md
docs/SCRATCH.md

# Personal copy of the D&D 5.2.1 SRD reference used as a writing aid.
# Not part of the project; not redistributable.
docs/SRD_CC_v5.2.1.pdf
docs/SRD_CC_v5.2.1.textClipping

# Local screen recordings the operator captured for their own reference.
# Live in a `recordings/` folder at the repo root; not part of the project.
/recordings/

# Archived planning docs.  These are frozen historical references — the
# files inside are still tracked at their archived paths (so links survive),
# but no NEW files should be added or modified there.  Tooling treats this
# folder as read-only history.
docs/archive/*