# Before adding things like .DS_Store, ignores for your editors, etc, consider
# instead to use a global git ignore. This keeps the ignores here clean, and
# specific to this project - not your text editor, OS, or other tooling.
#
# Attempts to ignore files specific to your configuration will be rejected.
#
# Please justify all ignore entries with comments.

# Ignore cargo generated build artifacts.
target/

# Elm build cache.
frontend/elm-stuff/

# Compiled Elm bundle (generated by elm-make; not checked in).
frontend/public/elm.js

# Dice-roller history persistence file (created at runtime by the server;
# location is configurable via --dice-history-path).
dice-history.json

# Live-encounter persistence file (created at runtime by the server;
# location is configurable via --encounter-path).  Anchored to the
# repo root so it doesn't shadow any same-named file inside the tree.
/encounter.json

# Named encounter-saves persistence file (created at runtime by the
# server; location is configurable via --encounter-saves-path).
/encounter-saves.json

# Runtime compendium directory (created at runtime by the server when
# bootstrapping; location is configurable via --compendium-path).
# Leading slash anchors the rule to repo root so it doesn't shadow
# the source-side `frontend/src/Compendium/` module directory.
/compendium/

# Per-user Claude Code overrides (the shared .claude/settings.json IS checked in).
.claude/settings.local.json

# Claude Code session memory — must never be committed even if a session
# accidentally writes there instead of ~/.claude/projects/.
.claude/projects/

# Personal scratchpads — design prompts and ad-hoc notes; not part of the project.
docs/PROMPTS.md
docs/SCRATCH.md

# Archived planning docs.  These are frozen historical references — the
# files inside are still tracked at their archived paths (so links survive),
# but no NEW files should be added or modified there.  Tooling treats this
# folder as read-only history.
docs/archive/*