# ezpz-dndz future-state data model.
# Render: nix develop --command d2 docs/diagrams/data-model.d2 docs/diagrams/data-model.svg
#
# Solid edges = strong references (FK, owned-by).
# Dashed edges = soft references (snapshot copy / nullable).
# Boxes grouped into bounded contexts: Identity, Library, Combat,
# Telemetry, Preferences.

direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 30
  }
}

# ============================================================
# IDENTITY CONTEXT — who can act
# ============================================================
identity: {
  label: "Identity"
  style.fill: "#fef3c7"
  style.stroke: "#b07900"
  style.stroke-width: 2
  style.font-size: 18
  style.bold: true

  user: {
    shape: sql_table
    id: "uuid PK"
    oidc_subject: "text UNIQUE"
    display_name: "text"
    role: "enum(admin,dm,player)"
    created_at: "timestamptz"
    updated_at: "timestamptz"
  }

  session: {
    shape: sql_table
    token: "text PK (signed cookie)"
    user_id: "uuid FK -> user.id"
    expires_at: "timestamptz"
    created_at: "timestamptz"
  }

  preferences: {
    shape: sql_table
    user_id: "uuid PK FK -> user.id"
    theme: "enum(system,light,dark)"
    card_density: "enum(compact,regular,spacious)"
    sound_enabled: "boolean"
    default_compendium_sort: "text"
    json_blob: "jsonb (extensibility)"
  }
}

# ============================================================
# LIBRARY CONTEXT — reusable templates
# ============================================================
library: {
  label: "Library"
  style.fill: "#dbeafe"
  style.stroke: "#1d4ed8"
  style.stroke-width: 2
  style.font-size: 18
  style.bold: true

  creature: {
    shape: sql_table
    id: "uuid PK"
    owner_id: "uuid NULLABLE FK -> user.id"
    visibility: "enum(private,shared,official)"
    name: "text"
    kind: "enum(player,enemy,npc)"
    size: "enum(tiny..gargantuan)"
    cr: "text (1/4, 24)"
    armor_class: "int"
    max_hp: "int"
    initiative_bonus: "int"
    stat_block: "jsonb (full schema)"
    created_at: "timestamptz"
    updated_at: "timestamptz"
  }

  encounter_template: {
    shape: sql_table
    id: "uuid PK"
    owner_id: "uuid FK -> user.id"
    name: "text"
    description: "text"
    creature_refs: "jsonb (id + count + suggested_init_mod)"
    created_at: "timestamptz"
    updated_at: "timestamptz"
  }
}

# ============================================================
# COMBAT CONTEXT — live + saved combat state
# ============================================================
combat: {
  label: "Combat"
  style.fill: "#dcfce7"
  style.stroke: "#15803d"
  style.stroke-width: 2
  style.font-size: 18
  style.bold: true

  encounter: {
    shape: sql_table
    id: "uuid PK"
    owner_id: "uuid FK -> user.id"
    template_id: "uuid NULLABLE FK -> encounter_template.id"
    name: "text"
    state: "jsonb (full Encounter)"
    active_name: "text"
    round: "int"
    started_at: "timestamptz"
    last_modified: "timestamptz"
  }

  combatant: {
    shape: sql_table
    id: "uuid PK"
    encounter_id: "uuid FK -> encounter.id"
    creature_id: "uuid NULLABLE FK -> creature.id"
    instance_data: "jsonb (snapshot of stats + live state)"
    initiative: "int"
    queue_order: "int"
  }

  encounter_snapshot: {
    shape: sql_table
    id: "uuid PK"
    encounter_id: "uuid FK -> encounter.id"
    state: "jsonb (full Encounter at moment)"
    created_at: "timestamptz"
    cause: "enum(autosave,manual,undo_point)"
  }
}

# ============================================================
# TELEMETRY CONTEXT — what happened
# ============================================================
telemetry: {
  label: "Telemetry"
  style.fill: "#fce7f3"
  style.stroke: "#be185d"
  style.stroke-width: 2
  style.font-size: 18
  style.bold: true

  dice_roll: {
    shape: sql_table
    id: "uuid PK"
    user_id: "uuid NULLABLE FK -> user.id"
    encounter_id: "uuid NULLABLE FK -> encounter.id"
    created_at: "timestamptz"
    roll_json: "jsonb (Dice.Roll record)"
    source_feature: "text indexed"
    source_target: "text"
  }

  combat_log_entry: {
    shape: sql_table
    id: "uuid PK"
    encounter_id: "uuid FK -> encounter.id"
    actor_name: "text"
    kind: "enum(damage,heal,tempHp,condition,death_save,save,turn_advance)"
    payload_json: "jsonb"
    round: "int"
    created_at: "timestamptz"
  }
}

# ============================================================
# RELATIONSHIPS
# ============================================================
identity.session -> identity.user: "has"
identity.preferences -> identity.user: "1:1"

library.creature -> identity.user: "owned_by\n(NULL = bundled)" {
  style.stroke-dash: 3
}
library.encounter_template -> identity.user: "owned_by"
library.encounter_template -> library.creature: "references" {
  style.stroke-dash: 3
}

combat.encounter -> identity.user: "owned_by"
combat.encounter -> library.encounter_template: "instantiated_from" {
  style.stroke-dash: 3
}
combat.combatant -> combat.encounter: "belongs_to"
combat.combatant -> library.creature: "instantiated_from\n(NULL = ad-hoc)" {
  style.stroke-dash: 3
}
combat.encounter_snapshot -> combat.encounter: "captures"

telemetry.dice_roll -> identity.user: "rolled_by" {
  style.stroke-dash: 3
}
telemetry.dice_roll -> combat.encounter: "during" {
  style.stroke-dash: 3
}
telemetry.combat_log_entry -> combat.encounter: "logged_in"
